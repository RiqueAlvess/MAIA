# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite o arquivo .env — ele já está listado no .gitignore.
# Em produção, use um gerenciador de segredos (Azure Key Vault, GitHub Actions secrets etc.)
# em vez de manter valores reais em disco.

ENVIRONMENT=development

# DATABASE_URL não precisa ser definida aqui ao usar docker-compose: o serviço
# backend a recebe automaticamente a partir de POSTGRES_PASSWORD (arquivo .env
# na raiz do projeto). Para rodar o backend fora do Docker, defina-a manualmente:
# DATABASE_URL=postgresql+asyncpg://maia:SENHA@localhost:5432/maia

# Chave da API Anthropic (Claude). Sem esse valor, a geração de entregáveis retorna erro.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4000

# Credenciais de aplicativo (client credentials) para acesso app-only ao Microsoft Graph.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SITE_ID=

# Microsoft Entra ID — validação de token dos usuários do painel.
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

CORS_ALLOWED_ORIGINS=http://localhost:4200
