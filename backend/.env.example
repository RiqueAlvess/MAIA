# Este arquivo é opcional: o backend sobe com valores padrão mesmo sem ele
# (banco SQLite local, geração de entregáveis desabilitada até a chave da IA
# ser configurada). Copie para .env e preencha conforme for habilitando cada
# integração. Nunca commite o arquivo .env — ele já está listado no .gitignore.
# Em produção, use um gerenciador de segredos (Azure Key Vault, GitHub Actions
# secrets etc.) em vez de manter valores reais em disco.

ENVIRONMENT=development

# Banco SQLite local — usado automaticamente, não precisa ser alterado.
# Em docker-compose o arquivo fica em um volume próprio (persiste entre reinícios).
# DATABASE_URL=sqlite+aiosqlite:///./data/maia.db

# Chave da API Anthropic (Claude). Sem esse valor, a geração de entregáveis retorna erro.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4000

# Credenciais de aplicativo (client credentials) para acesso app-only ao Microsoft Graph.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SITE_ID=

# Microsoft Entra ID — validação de token dos usuários do painel.
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

CORS_ALLOWED_ORIGINS=http://localhost:4200
